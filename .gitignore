# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated VS/Rider/VSCode files
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Addressables / Burst
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
*_BurstDebugInformation_DoNotShip/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Mixamo characters/animations (~570 MB): too big for free GitHub LFS (1 GB), shared as an archive
/[Aa]ssets/ThirdParty/Mixamo/
/[Aa]ssets/ThirdParty/Mixamo.meta

# Archives prepared for sharing via cloud drive
/_ForDrive/

# Heavy third-party packs (tree pack 325 MB, trash pack 252 MB): shared as an archive with .meta files so GUIDs match
/[Aa]ssets/TreePackVol.1/
/[Aa]ssets/TreePackVol.1.meta
/[Aa]ssets/URP_WasteOvergrowth_SA/
/[Aa]ssets/URP_WasteOvergrowth_SA.meta

# local tooling
/.codegraph/

# Toolbox textures and their Unity metadata are distributed separately.
/Assets/_Project/Models/Toolbox/Textures/Tool_box_Albedo.png
/Assets/_Project/Models/Toolbox/Textures/Tool_box_Albedo.png.meta
/Assets/_Project/Models/Toolbox/Textures/Tool_box_Normal.png
/Assets/_Project/Models/Toolbox/Textures/Tool_box_Normal.png.meta

# Asset packs shared separately (from carx-scenes-integration)
/Assets/Abandoned World/
/Assets/Abandoned World.meta

