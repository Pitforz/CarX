  m_Script: {fileID: 11500000, guid: ae53ef3b63a947efa6369e31d8717419, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CarX.NPC.NpcDialogue
  _interactionDistance: 2.5
  _displayName: "Виктор"
  _firstQuestion: "А ты знаешь, как попасть вниз?"
  _secondQuestion: "Уйти"
  _closeOption: ""
  _firstAnswer:
  - "Тут недалеко есть дверь, за ней лестница вниз."
  - "Дверь заперта, нужен ключ, а у меня его нет."
  _firstQuestionVoice: {fileID: 8300000, guid: d14787fe9731456ba36ce2ab80c3c578, type: 3}
