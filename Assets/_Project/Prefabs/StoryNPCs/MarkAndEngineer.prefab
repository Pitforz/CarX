  - {fileID: 8300000, guid: 6af58e64e3a14f2aba90e7dfe67975ab, type: 3}
  - {fileID: 8300000, guid: 5852ba9e76d94cd9b48b4976a4ef1ee2, type: 3}
  - {fileID: 8300000, guid: 4c05aec855674236b05f6bc64d4eed5f, type: 3}
  - {fileID: 8300000, guid: 3cc8f4d67fd44eb3be569cf1a904978b, type: 3}
  _followUps:
  - _question: "\u041F\u043E\u0447\u0435\u043C\u0443 \u0432 \u043E\u0447\u043A\u0430\u0445? \u0417\u0434\u0435\u0441\u044C \u0436\u0435 \u0442\u0435\u043C\u043D\u043E."
    _answer: "\u041C\u043D\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442."
    _questionVoice: {fileID: 8300000, guid: 26b7c20d2936419fa6f9c11d8d1feec2, type: 3}
    _answerVoice: {fileID: 8300000, guid: 6c230feeb58f438892a266b9f711088d, type: 3}
  - _question: "\u041E\u0442\u0435\u0446 \u043E\u0434\u0438\u043D \u043F\u0440\u0438\u0448\u0451\u043B?"
    _answer: "\u041E\u0434\u0438\u043D. \u041A\u043E\u043D\u0432\u0435\u0440\u0442 \u0441 \u0441\u043E\u0431\u043E\u0439 \u043D\u0451\u0441. \u0412\u0441\u0451 \u0441\u043F\u0440\u0430\u0448\u0438\u0432\u0430\u043B, \u0433\u0434\u0435 \u0434\u0435\u043D\u044C\u0433\u0438 \u0432\u044B\u0434\u0430\u044E\u0442. \u042F \u0435\u0433\u043E \u043A \u0414\u0435\u043D\u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B."
    _questionVoice: {fileID: 8300000, guid: 5be85768858f4acfb98d212ecd80f1fb, type: 3}
    _answerVoice: {fileID: 8300000, guid: c3485fe000714a61a5399a8ee87971a1, type: 3}
  - _question: "\u0422\u044B \u0443\u0432\u0435\u0440\u0435\u043D, \u0447\u0442\u043E \u044D\u0442\u0430\u0436\u0435\u0439 \u0434\u0432\u0430?"
    _answer: "\u0414\u0432\u0430, \u044F \u0437\u043D\u0430\u044E. \u0412 \u0441\u0442\u0430\u0440\u044B\u0435 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u044B \u043D\u0435 \u043B\u0435\u0437\u0443."
    _questionVoice: {fileID: 8300000, guid: 9e1dd1a0aee5433d9045ca862c6595a5, type: 3}
    _answerVoice: {fileID: 8300000, guid: edf0bf65ec0a479196679c12f94b1ce3, type: 3}
