--- !u!114 &722200000000000033
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 722200000000000030}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ae53ef3b63a947efa6369e31d8717419, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CarX.NPC.NpcDialogue
  _interactionDistance: 2.6
  _displayName: "\u0421\u0443\u043C\u0430\u0441\u0448\u0435\u0434\u0448\u0438\u0439"
  _firstQuestion: 
  _firstQuestionLine: 
  _secondQuestion: 
  _closeOption: "\u0423\u0439\u0442\u0438"
  _firstAnswer: []
  _firstQuestionVoice: {fileID: 0}
  _firstAnswerVoices: []
  _grantsLowerFloorHint: 0
  _requiresKeyObjective: 0
  _startsFatherSearch: 0
  _answerOnlyOnce: 0
  _idleArmClearance: 0
  _automaticGreetingDistance: 4.7
  _introduction:
  - _alexey: 0
    _thought: 0
    _text: "\u041E\u043F\u044F\u0442\u044C\u2026 \u041E-\u043E\u043F\u044F\u0442\u044C. \u0412\u0438\u0434\u0438\u0448\u044C, \u0438\u0434\u0443\u0442. \u0413\u043E\u0441\u0442\u0438 \u043F\u0440\u0438\u0448\u043B\u0438, \u0432 \u043D\u043E\u0440\u044B \u0441\u043F\u0443\u0441\u043A\u0430\u044E\u0442\u0441\u044F."
    _voice: {fileID: 8300000, guid: d773d4c619ad4a41b7b080f675043e0d, type: 3}
  - _alexey: 1
    _thought: 0
    _text: "\u041A\u0430\u043A\u0438\u0435 \u043D\u043E\u0440\u044B?"
    _voice: {fileID: 8300000, guid: 6846f08bf7674ea18c914aa7ba26fa71, type: 3}
  - _alexey: 0
    _thought: 0
    _text: "\u041E-\u043E, \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u0435 \u043D\u043E\u0440\u044B, \u0441 \u0434\u0432\u043E\u0439\u043D\u044B\u043C \u0434\u043D\u043E\u043C. \u041E\u0431\u043C\u0430\u043D, \u043A\u0440\u0443\u0433\u043E\u043C \u043E\u0431\u043C\u0430\u043D."
    _voice: {fileID: 8300000, guid: cb7c9d5aca6f4e228fc602e301250b6c, type: 3}
  - _alexey: 1
    _thought: 1
    _text: "\u0412\u0438\u0434\u0438\u043C\u043E, \u043A\u0430\u043A\u043E\u0439-\u0442\u043E \u043C\u0435\u0441\u0442\u043D\u044B\u0439 \u0441\u0443\u043C\u0430\u0441\u0448\u0435\u0434\u0448\u0438\u0439."
    _voice: {fileID: 8300000, guid: bfd1bed72a25497f91d1d36d7a9250e1, type: 3}
  _flashlightWarning:
    _alexey: 0
    _thought: 0
    _text: 
    _voice: {fileID: 0}
  _afterAnswerThought: 
  _introductionPose: {fileID: 0}
  _activateAfterIntroduction: {fileID: 0}
