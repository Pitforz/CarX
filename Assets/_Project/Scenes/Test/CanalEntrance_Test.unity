--- !u!114 &724600000000000001
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 723300000000000010}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ae53ef3b63a947efa6369e31d8717419, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CarX.NPC.NpcDialogue
  _interactionDistance: 2.5
  _displayName: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u043D\u0430 \u044F\u0449\u0438\u043A\u0435"
  _firstQuestion: "\u0421\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043F\u0440\u043E \u043A\u043B\u044E\u0447"
  _firstQuestionLine: "\u0421\u043B\u0443\u0448\u0430\u0439, \u0443 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C \u043A\u043B\u044E\u0447 \u043E\u0442 \u0434\u0432\u0435\u0440\u0438 \u043D\u0430 \u0432\u0442\u043E\u0440\u043E\u0439 \u044D\u0442\u0430\u0436?"
  _secondQuestion: 
  _closeOption: "\u0423\u0439\u0442\u0438"
  _firstAnswer:
  - "\u041A\u043B\u044E\u0447? \u0415\u0441\u0442\u044C \u043E\u0434\u0438\u043D. \u0414\u0432\u0435\u0441\u0442\u0438 \u0431\u0430\u043A\u0441\u043E\u0432, \u0438 \u043E\u043D \u0442\u0432\u043E\u0439."
  _firstQuestionVoice: {fileID: 8300000, guid: b479a0eb52e241dbb4af65bc72b53e10, type: 3}
  _firstAnswerVoices:
  - {fileID: 8300000, guid: becb8423cc5f4bd3a20f024ad4afd12d, type: 3}
  _grantsLowerFloorHint: 0
  _requiresKeyObjective: 1
  _startsFatherSearch: 0
