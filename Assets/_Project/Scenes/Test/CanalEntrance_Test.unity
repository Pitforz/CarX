--- !u!114 &722200000000000013
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 722200000000000010}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ae53ef3b63a947efa6369e31d8717419, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CarX.NPC.NpcDialogue
  _interactionDistance: 2.6
  _displayName: "\u0421\u0430\u0439\u043C\u043E\u043D"
  _firstQuestion: "\u041E\u0442\u0435\u0446 \u0432\u044B\u0433\u043B\u044F\u0434\u0435\u043B \u0440\u0430\u043D\u0435\u043D\u044B\u043C?"
  _firstQuestionLine: 
  _secondQuestion: 
  _closeOption: "\u0423\u0439\u0442\u0438"
  _firstAnswer:
  - "\u041D\u0435\u0442. \u0417\u043B\u044B\u043C. \u0412\u0441\u0451 \u043F\u043E\u0432\u0442\u043E\u0440\u044F\u043B: \xAB\u042F \u0441\u0432\u043E\u0451 \u043F\u043E\u043B\u0443\u0447\u0443\xBB. \u0415\u043C\u0443 \u0441\u043A\u0430\u0437\u0430\u043B\u0438, \u0432\u043D\u0438\u0437\u0443 \u0440\u0430\u0437\u0431\u0435\u0440\u0443\u0442\u0441\u044F."
  _firstQuestionVoice: {fileID: 8300000, guid: a656a8d0dda143cb87e76e9a8c2b2e6c, type: 3}
  _firstAnswerVoices:
  - {fileID: 8300000, guid: 6348156cd6a440a5a9b3de3f05ef4266, type: 3}
  _grantsLowerFloorHint: 0
  _requiresKeyObjective: 0
  _startsFatherSearch: 1
  _answerOnlyOnce: 1
  _idleArmClearance: 0
  _automaticGreetingDistance: 7.5
  _introduction:
  - _alexey: 1
    _thought: 0
    _text: "\u042F \u0438\u0449\u0443 \u043E\u0442\u0446\u0430. \u042F \u0443\u0437\u043D\u0430\u043B, \u0447\u0442\u043E \u043E\u043D \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0441\u044F \u0441\u044E\u0434\u0430. \u0412 \u0432\u043E\u0437\u0440\u0430\u0441\u0442\u0435 \u0442\u0430\u043A\u043E\u0439, \u0441 \u043A\u043E\u043D\u0432\u0435\u0440\u0442\u043E\u043C \u0431\u044B\u043B."
    _voice: {fileID: 8300000, guid: c28801dfed2443cf8b1dae4e52c470cf, type: 3}
  - _alexey: 0
    _thought: 0
    _text: "\u0412\u0438\u0434\u0435\u043B. \u041E\u0434\u0438\u043D \u0440\u0430\u0437. \u0415\u0433\u043E \u0434\u0432\u043E\u0435 \u0432\u0441\u0442\u0440\u0435\u0442\u0438\u043B\u0438, \u0443\u0432\u0435\u043B\u0438 \u0434\u0430\u043B\u044C\u0448\u0435."
    _voice: {fileID: 8300000, guid: d8c170dd6ea94ea88434d45ba05f025d, type: 3}
  - _alexey: 1
    _thought: 0
    _text: "\u041A\u0443\u0434\u0430?"
    _voice: {fileID: 8300000, guid: 02a632454e534494865fe0e108eaf51e, type: 3}
  - _alexey: 0
    _thought: 0
    _text: "\u041F\u0440\u044F\u043C\u043E."
    _voice: {fileID: 8300000, guid: 9aaf3737c06a4eafb4d8e65b91e250a4, type: 3}
  - _alexey: 1
    _thought: 0
    _text: "\u0417\u0434\u0435\u0441\u044C \u0435\u0449\u0451 \u0433\u0434\u0435-\u0442\u043E \u0436\u0438\u0432\u0443\u0442?"
    _voice: {fileID: 8300000, guid: 14443795c8de459a9e69013cce90ff06, type: 3}
  - _alexey: 0
    _thought: 0
    _text: "\u0417\u0434\u0435\u0441\u044C \u043D\u0435 \u0436\u0438\u0432\u0443\u0442, \u043C\u0443\u0436\u0438\u043A. \u0417\u0440\u044F \u0442\u044B \u0441\u044E\u0434\u0430 \u0441\u043F\u0443\u0441\u0442\u0438\u043B\u0441\u044F."
    _voice: {fileID: 8300000, guid: cf638e4272504a29923369f6f3aa0370, type: 3}
  - _alexey: 0
    _thought: 0
    _text: "\u0425\u043E\u0442\u044F \u0432 \u0434\u0430\u043B\u044C\u043D\u0438\u0445 \u043A\u043E\u043C\u043D\u0430\u0442\u0430\u0445, \u043C\u043E\u0436\u0435\u0442, \u043A\u0442\u043E-\u0442\u043E \u0438 \u0435\u0441\u0442\u044C. \u0412\u043E\u0442 \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u0441\u0435, \u043A\u0442\u043E \u0442\u0430\u043C \u0436\u0438\u0432\u0443\u0442, \u043D\u0430 \u043B\u044E\u0434\u0435\u0439 \u0443\u0436\u0435 \u043D\u0435 \u043F\u043E\u0445\u043E\u0436\u0438 \u0434\u0430\u0432\u043D\u043E."
    _voice: {fileID: 8300000, guid: 6878bbdc9acc4d42a1514a4ade8ff431, type: 3}
  - _alexey: 0
    _thought: 0
    _text: "\u041F\u043E\u0439\u0434\u0451\u0448\u044C \u0434\u0430\u043B\u044C\u0448\u0435 \u2014 \u043D\u0430\u0437\u0430\u0434 \u043F\u0443\u0442\u0438 \u043D\u0435 \u0431\u0443\u0434\u0435\u0442."
    _voice: {fileID: 8300000, guid: 31ca7e9c14384bb69de8021c6a445149, type: 3}
  - _alexey: 0
    _thought: 0
    _text: "\u0414\u0430\u043B\u044C\u0448\u0435 \u0444\u043E\u043D\u0430\u0440\u044C \u043D\u0435 \u0432\u043A\u043B\u044E\u0447\u0430\u0439."
    _voice: {fileID: 8300000, guid: 2155f05f64a94023a47bf367a404eee7, type: 3}
  _flashlightWarning:
    _alexey: 0
    _thought: 0
    _text: "\u041E\u0442\u0432\u0435\u0434\u0438 \u0444\u043E\u043D\u0430\u0440\u044C."
    _voice: {fileID: 8300000, guid: 58e631aa8cfb416eb35ac5444e4653da, type: 3}
  _afterAnswerThought: "\u0414\u0430\u0436\u0435 \u0437\u0434\u0435\u0441\u044C \u0442\u044B \u0440\u0435\u0448\u0438\u043B, \u0447\u0442\u043E \u043F\u0435\u0440\u0435\u0438\u0433\u0440\u0430\u0435\u0448\u044C \u0438\u0445."
  _introductionPose: {fileID: 722200000000000015}
  _activateAfterIntroduction: {fileID: 722200000000000050}
