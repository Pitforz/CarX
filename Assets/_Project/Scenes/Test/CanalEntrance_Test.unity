  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CarX.NPC.NpcDialogue
  _interactionDistance: 3.2
  _displayName: "\u041C\u0443\u0436\u0447\u0438\u043D\u0430 \u0432 \u0442\u043E\u043D\u043D\u0435\u043B\u0435"
  _firstQuestion: "\u0421\u043F\u0440\u043E\u0441\u0438\u0442\u044C \u043E\u0431 \u043E\u0442\u0446\u0435"
  _firstQuestionLine: "\u0421\u043B\u0443\u0448\u0430\u0439, \u0442\u0443\u0442 \u043F\u043E\u0436\u0438\u043B\u043E\u0439 \u043C\u0443\u0436\u0447\u0438\u043D\u0430 \u043D\u0435 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043B? \u0412\u044B\u0441\u043E\u043A\u0438\u0439, \u0441 \u043A\u043E\u043D\u0432\u0435\u0440\u0442\u043E\u043C \u0432 \u0440\u0443\u043A\u0430\u0445."
  _secondQuestion: 
  _closeOption: "\u0423\u0439\u0442\u0438"
  _firstAnswer:
  - "\u041D\u0435\u0442, \u043D\u0435 \u0432\u0438\u0434\u0435\u043B. \u042F \u0437\u0434\u0435\u0441\u044C \u043D\u0435\u0434\u0430\u0432\u043D\u043E. \u041C\u043E\u0436\u0435\u0442, \u043E\u043D \u0440\u0430\u043D\u044C\u0448\u0435 \u043F\u0440\u043E\u0448\u0451\u043B."
  _firstQuestionVoice: {fileID: 8300000, guid: 22cc16bda0d642ef8e06b1b16710afe9, type: 3}
  _firstAnswerVoices:
  - {fileID: 8300000, guid: 9a7828de98234a42bd0c0ef12f83bfa7, type: 3}
