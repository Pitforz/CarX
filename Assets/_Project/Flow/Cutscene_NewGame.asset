    title: 
    lines:
    - speaker: "\u0412\u0438\u043A\u0442\u043E\u0440"
      text: "\u0417\u0434\u043E\u0440\u043E\u0432\u043E. \u0422\u044B \u0443 \u043C\u0435\u043D\u044F \u0441\u0432\u043E\u0438 \u0447\u0430\u0441\u044B \u0437\u0430\u0431\u044B\u043B. \u0417\u0430\u0432\u0442\u0440\u0430 \u0437\u0430\u0435\u0434\u0435\u0448\u044C \u0437\u0430\u0431\u0440\u0430\u0442\u044C?"
      time: 0.06
    - speaker: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
      text: "\u041D\u0435 \u0441\u043C\u043E\u0433\u0443."
      time: 5.26
    - speaker: "\u0412\u0438\u043A\u0442\u043E\u0440"
      text: "\u0421\u043C\u0435\u043D\u0430?"
      time: 6.8
    - speaker: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
      text: "\u041D\u0435\u0442, \u0435\u0434\u0443 \u0432 \u0442\u0435 \u043A\u0430\u0442\u0430\u043A\u043E\u043C\u0431\u044B, \u043F\u0440\u043E \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0432 \u0433\u0430\u0437\u0435\u0442\u0435 \u043F\u0438\u0441\u0430\u043B\u0438."
      time: 8.03
    - speaker: "\u0412\u0438\u043A\u0442\u043E\u0440"
      text: "\u042F \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u0434\u043E \u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0430 \u0434\u043E\u0437\u0432\u043E\u043D\u0438\u043B\u0441\u044F. \u041E\u043D \u0441\u043D\u0438\u043C\u0430\u043B \u043D\u0430 \u043F\u0440\u043E\u0448\u043B\u043E\u0439 \u043D\u0435\u0434\u0435\u043B\u0435."
      time: 13.98
    - speaker: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
      text: "\u041F\u0440\u043E \u043C\u0443\u0436\u0438\u043A\u0430 \u0443 \u0432\u0445\u043E\u0434\u0430 \u0441\u043F\u0440\u043E\u0441\u0438\u043B?"
      time: 18.76
    - speaker: "\u0412\u0438\u043A\u0442\u043E\u0440"
      text: "\u0421\u043F\u0440\u043E\u0441\u0438\u043B. \u041E\u043D \u0435\u0433\u043E \u043D\u0435 \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u043B. \u041D\u043E \u044F \u0443\u0437\u043D\u0430\u043B \u043E\u0442\u0446\u0430. \u0415\u0449\u0451 \u043A\u043E\u0433\u0434\u0430 \u0442\u044B \u043C\u043D\u0435 \u0433\u0430\u0437\u0435\u0442\u0443 \u043F\u043E\u043A\u0430\u0437\u0430\u043B."
      time: 21.3
    - speaker: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
      text: "\u0410 \u0441\u043A\u0430\u0437\u0430\u043B, \u0447\u0442\u043E \u043D\u0435 \u043F\u043E\u0445\u043E\u0436."
      time: 28.4
    - speaker: "\u0412\u0438\u043A\u0442\u043E\u0440"
      text: "\u0425\u043E\u0442\u0435\u043B, \u0447\u0442\u043E\u0431\u044B \u043D\u0435 \u0431\u044B\u043B \u043F\u043E\u0445\u043E\u0436."
      time: 31.36
    - speaker: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
      text: "\u041E\u043D \u0437\u0430\u0431\u0440\u0430\u043B \u043D\u0430\u0448\u0438 \u0434\u0435\u043D\u044C\u0433\u0438 \u0438 \u0443\u0448\u0451\u043B. \u042F \u0434\u0443\u043C\u0430\u043B, \u0435\u0441\u043B\u0438 \u0443\u0432\u0438\u0436\u0443 \u0435\u0433\u043E \u0441\u043D\u043E\u0432\u0430, \u043F\u0435\u0440\u0432\u044B\u043C \u0434\u0435\u043B\u043E\u043C \u0441\u043F\u0440\u043E\u0448\u0443 \u043F\u0440\u043E \u0434\u0435\u043D\u044C\u0433\u0438."
      time: 34.01
    - speaker: "\u0412\u0438\u043A\u0442\u043E\u0440"
      text: "\u0410 \u0442\u0435\u043F\u0435\u0440\u044C?"
      time: 41.81
    - speaker: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
      text: "\u0422\u0435\u043F\u0435\u0440\u044C \u0445\u043E\u0447\u0443 \u0437\u043D\u0430\u0442\u044C, \u043F\u043E\u0447\u0435\u043C\u0443 \u043E\u043D \u0442\u0430\u043A \u0438 \u043D\u0435 \u043F\u043E\u0437\u0432\u043E\u043D\u0438\u043B."
      time: 43.75
    - speaker: "\u0412\u0438\u043A\u0442\u043E\u0440"
      text: "\u0422\u044B \u043E\u0434\u0438\u043D \u0435\u0434\u0435\u0448\u044C?"
      time: 47.49
    - speaker: "\u0410\u043B\u0435\u043A\u0441\u0435\u0439"
      text: "\u0414\u0430."
      time: 49.46
    - speaker: "\u0412\u0438\u043A\u0442\u043E\u0440"
      text: "\u041A\u0430\u043A \u0432\u044B\u0439\u0434\u0435\u0448\u044C, \u043D\u0430\u0431\u0435\u0440\u0438. \u0414\u0430\u0436\u0435 \u0435\u0441\u043B\u0438 \u043D\u0438\u0447\u0435\u0433\u043E \u043D\u0435 \u0443\u0437\u043D\u0430\u0435\u0448\u044C."
      time: 51.49
