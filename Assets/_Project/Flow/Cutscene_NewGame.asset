  targetScene: CanalEntrance_Test
  fadeOut: 1.4
  blackHold: 0.8
  fadeColor: {r: 0, g: 0, b: 0, a: 1}
  cards:
  - text: "\u0417\u0410\u0413\u041B\u0423\u0428\u041A\u0410 \u0421\u0426\u0415\u041D\u0410\u0420\u0418\u042F.\n\u041B\u0430\u0441-\u0412\u0435\u0433\u0430\u0441. \u041C\u043E\u0442\u0435\u043B\u044C \xAB\u041F\u044B\u043B\u044C\u043D\u0430\u044F \u0440\u043E\u0437\u0430\xBB, 03:12."
    fadeIn: 1
    hold: 3.2
    fadeOut: 0.9
    pauseAfter: 0.5
    typewriter: 0
    charsPerSecond: 28
    sound: {fileID: 0}
    soundVolume: 1
  - text: "\u0421\u0442\u0430\u0440\u044B\u0439 \xAB\u041A\u0440\u0430\u0439\u0441\u043B\u0435\u0440\xBB \u043F\u043E\u043B\u0437\u0451\u0442 \u043F\u043E \u0411\u0443\u043B\u044C\u0432\u0430\u0440\u0443 \u043C\u0438\u043C\u043E \u043F\u043E\u0433\u0430\u0441\u0448\u0438\u0445 \u0432\u044B\u0432\u0435\u0441\u043E\u043A."
    fadeIn: 1
    hold: 3.2
    fadeOut: 0.9
    pauseAfter: 0.5
    typewriter: 0
    charsPerSecond: 28
    sound: {fileID: 0}
    soundVolume: 1
  - text: "\u041F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0439 \u0430\u0434\u0440\u0435\u0441, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043D\u0430\u0437\u0432\u0430\u043B \u043E\u0442\u0435\u0446, \u2014 \u0432\u043E\u0434\u043E\u043E\u0442\u0432\u043E\u0434\u043D\u044B\u0439 \u043A\u0430\u043D\u0430\u043B \u0437\u0430 \u0448\u043E\u0441\u0441\u0435."
    fadeIn: 1
    hold: 3.6
    fadeOut: 0.9
    pauseAfter: 0.5
    typewriter: 0
    charsPerSecond: 28
    sound: {fileID: 0}
    soundVolume: 1
  - text: "\u0414\u0430\u043B\u044C\u0448\u0435 \u043F\u0435\u0448\u043A\u043E\u043C."
    fadeIn: 0.6
    hold: 2.2
    fadeOut: 0.9
    pauseAfter: 0.5
    typewriter: 0
    charsPerSecond: 28
    sound: {fileID: 0}
    soundVolume: 1
